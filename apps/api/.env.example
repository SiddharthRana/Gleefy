# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the website).
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (e.g. 1 behind Fly.io/Render). 0 = direct.
TRUST_PROXY_HOPS=0

# --- Database (Supabase Postgres). Use the pooled connection string in production. ---
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase Auth (purchasers only; guests never sign in) ---
# Project URL, e.g. https://<project-ref>.supabase.co (local: http://127.0.0.1:54321)
SUPABASE_URL=http://127.0.0.1:54321
# Optional: legacy HS256 JWT secret. Leave empty to verify tokens via the project's JWKS (recommended).
SUPABASE_JWT_SECRET=
# Supabase secret key (sb_secret_… or legacy service_role). Server-only! Deletes the auth user when
# someone deletes their account. Without it, accounts are disabled at once and removed once it is set.
SUPABASE_SECRET_KEY=

# --- Error reporting (optional). Personal data is scrubbed before sending. Empty = log only. ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
USER_RATE_LIMIT_PER_MINUTE=120
# Hourly webhook-payload purge and pending-deletion retries in this process.
MAINTENANCE_ENABLED=true

# --- Billing (sandbox/test credentials only until launch; see docs/payments-setup.md) ---
# Premium is a one-time unlock: one Dodo one-time product and one Google Play one-time product.
# none | dodo — confirm seller eligibility for your country first.
WEB_PAYMENT_PROVIDER=none
BILLING_RETURN_URL=http://localhost:3000/account?checkout=success
DODO_ENV=test
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_PREMIUM=
GOOGLE_PLAY_PACKAGE_NAME=com.gleefy.app
GOOGLE_PLAY_PRODUCT_ID=gleefy_premium_unlock
# Service account key JSON (raw or base64). Server-only secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_RTDN_AUDIENCE=
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=
# >= 32 random chars; HMAC key for the account id sent to Google Play. openssl rand -hex 32
BILLING_ACCOUNT_SECRET=
